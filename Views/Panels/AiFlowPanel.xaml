<UserControl x:Class="TaskFlow.Views.Panels.AiFlowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:conv="clr-namespace:TaskFlow.Converters"
             xmlns:res="clr-namespace:TaskFlow.Resources"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             d:DesignHeight="500" d:DesignWidth="320"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <!-- 圆角按钮模板 -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 平面风格 ComboBoxItem 样式 -->
        <Style x:Key="FlatComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 平面风格 ComboBox 样式 -->
        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlatComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,2,6,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L6,5 L12,0 Z" Margin="6,2,0,0" Width="8" Height="4" Stretch="Fill"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,2,20,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden"/>
                            <Popup x:Name="Popup" Placement="Top" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}" CornerRadius="8" Margin="0,0,0,4" MinWidth="{TemplateBinding ActualWidth}">
                                    <!-- A subtle shadow to give a popover feel -->
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="12" Opacity="0.1" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True" MaxHeight="250">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderLightBrush}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource CardShadowColor}" Opacity="0.18" BlurRadius="8" ShadowDepth="3" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- 标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内部容器 (包含消息和输入等) -->
                <RowDefinition Height="Auto"/> <!-- 底部提示语 -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,0"/>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="Orchid" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               FontFamily="Poppins, Arial, SimSun" Margin="0,0,0,2"/>
                    <Border Height="2" Background="{DynamicResource TitleUnderlineBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,-1"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 新建对话 -->
                    <Button x:Name="NewChatButton" Click="NewChat_Click" ToolTip="新建对话" Cursor="Hand"
                            Width="28" Height="28" BorderThickness="0" Margin="0,0,2,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 历史对话 -->
                    <Button x:Name="HistoryButton" Click="ToggleHistory_Click" ToolTip="{x:Static res:Strings.AiPanel_HistoryTitle}" Cursor="Hand"
                            Width="28" Height="28" BorderThickness="0" Margin="0,0,2,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 关闭 -->
                    <Button x:Name="ClosePanelButton" Click="ClosePanel_Click" ToolTip="关闭" Cursor="Hand"
                            Width="28" Height="28" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内部深色内容区 -->
            <Border Grid.Row="1" Background="Transparent" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- 消息列表 -->
                        <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
                        <RowDefinition Height="Auto"/> <!-- 报告区 -->
                        <RowDefinition Height="Auto"/> <!-- 整合输入区 -->
                    </Grid.RowDefinitions>

                    <!-- 消息列表与空状态提示合体 -->
                    <Grid Grid.Row="0">
                        <!-- 底部背景提示语 (仅在无消息时居中显示) -->

                        <!-- 历史对话内联面板（由于 WebView2 是 HwndHost，必须使用 Popup 突破空域限制置顶显示） -->
                        <Popup IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" StaysOpen="False" 
                               PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Bottom" 
                               HorizontalOffset="-220" VerticalOffset="8" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="HistoryPanel" Width="260" MaxHeight="450" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderLightBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="16" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Static res:Strings.AiPanel_HistoryTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="12,10,12,6" FontFamily="Poppins, Arial, SimSun"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                                        <ItemsControl x:Name="HistoryList" ItemsSource="{Binding Sessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="6,2" Padding="10,8" CornerRadius="6"
                                                            Background="{DynamicResource AppBackgroundBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <Border Grid.Column="0" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="HistoryItem_Click">
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" FontFamily="Lora, Georgia, SimSun"/>
                                                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Button Grid.Column="1" Click="DeleteHistory_Click" ToolTip="{x:Static res:Strings.AiPanel_DeleteTooltip}" Cursor="Hand"
                                                                    Width="24" Height="24" BorderThickness="0" VerticalAlignment="Center">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- 无历史时的空状态提示 -->
                                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.AiPanel_NoHistory}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}"/>
                                </Grid>
                            </Border>
                        </Popup>
                        <!-- WebView2 加载提示 (极简呼吸灯) -->
                        <StackPanel x:Name="WebViewLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✦" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.3" To="1" Duration="0:0:1.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </StackPanel>

                        <!-- WebView2 聊天消息区 -->
                        <wv2:WebView2 x:Name="ChatWebView" Visibility="Collapsed"/>

                        <!-- 加载状态提示 -->
                        <TextBlock Text="{Binding LoadingStatusText}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                   FontFamily="Poppins, Arial, SimSun, Segoe UI" FontStyle="Italic"
                                   HorizontalAlignment="Left"
                                   Margin="16,4,0,6"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

        <!-- 确认/重新生成 按钮区 -->
        <StackPanel Grid.Row="1" x:Name="ActionButtonPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="8,4"
                    Visibility="{Binding PendingPlan, Converter={StaticResource NullToCollapsedConverter}}">
            <Button x:Name="ConfirmButton" Content="✅ 确认创建" Click="ConfirmButton_Click"
                    Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                    Background="{DynamicResource PrimaryButtonBgBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="RegenerateButton" Content="🔄 重新生成" Click="RegenerateButton_Click"
                    Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 重试卡片（生成失败时显示） -->
        <Border Grid.Row="1" x:Name="RetryCard" Margin="12,8" Padding="16,14" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}" 
                BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}"
                Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="8" Opacity="0.1" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 标题行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="✕" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Arial" FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.AiPanel_ErrorTerminated}" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 描述行 -->
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.AiPanel_ErrorTerminatedDesc}" FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18"/>
                
                <!-- 操作区 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Dismiss" Click="DismissRetry_Click"
                            Padding="12,6" Cursor="Hand" FontSize="12" FontWeight="Medium"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Grid.Column="2" Content="{x:Static res:Strings.AiPanel_CopyDebug}" Click="CopyDebug_Click"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Medium"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Grid.Column="3" Content="Retry" Click="RetryButton_Click"
                            Padding="16,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                            Background="{DynamicResource PrimaryButtonBgBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 继续按钮（回复被截断时显示） -->
        <StackPanel Grid.Row="1" x:Name="ContinueButtonPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="8,4"
                    Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVisConverter}}">
            <Button x:Name="ContinueButton" Content="请继续" Click="ContinueButton_Click"
                    Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                    Background="{DynamicResource PrimaryButtonBgBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="DismissContinueButton" Content="取消" Click="DismissContinueButton_Click"
                    Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 自主模式批准区（等待用户批准中风险操作时显示） -->
        <Border Grid.Row="1" x:Name="ApprovalPanel"
                Visibility="{Binding AwaitingApproval, Converter={StaticResource BoolToVisConverter}}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="6" Margin="8,4" Padding="10,8">
            <StackPanel>
                <TextBlock x:Name="ApprovalText" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ApprovalDescription}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           FontFamily="Lora, Georgia, SimSun, Segoe UI"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ApproveButton" Content="✅ 批准执行" Click="ApproveButton_Click"
                            Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                            Background="{DynamicResource PrimaryButtonBgBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="AbortButton" Content="⏹ 中止" Click="AbortButton_Click"
                            Padding="16,6" Margin="4,0" Cursor="Hand" FontSize="13"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 报告区（可点击项） -->
        <Border Grid.Row="2" x:Name="ReportPanel"
                Visibility="{Binding HasReportItems, Converter={StaticResource BoolToVisConverter}}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,4">
                    <TextBlock Text="⚠️ 待配置项（点击编辑）：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"
                               FontFamily="Lora, Georgia, SimSun"/>
                    <ItemsControl x:Name="ReportList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="ReportItem_Click" Cursor="Hand"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="4,3" Margin="0,1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝 " FontSize="12"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextDecorations="Underline">
                                            <Run Text="{Binding CardName, Mode=OneWay}"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding Hint, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 整合输入区（WebView2 就绪前隐藏） -->
        <!-- 底部输入区域，带有入场上浮动画属性预设 -->
        <Border Grid.Row="3" x:Name="InputAreaBorder" Visibility="Collapsed" Opacity="0"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="16,8,16,8" Padding="12,10,12,10"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InputAreaTranslate" Y="20"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 附件预览 -->
                    <RowDefinition Height="*"/>    <!-- 输入框 -->
                    <RowDefinition Height="Auto"/> <!-- 工具栏 -->
                </Grid.RowDefinitions>

                <!-- 附件预览 -->
                <Border x:Name="AttachmentPreview" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="8,6" HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AttachmentFileName" Grid.Column="1" FontSize="13" MaxWidth="200"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontFamily="Lora, Georgia, SimSun"/>
                        <Button Grid.Column="2" Content="✕" Click="RemoveAttachment_Click"
                                Style="{StaticResource ToolbarButton}" Padding="6,2" Margin="6,0,0,0" FontSize="12"
                                Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                </Border>

                <!-- 输入框 -->
                <TextBox Grid.Row="1" x:Name="InputTextBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="14.5" Padding="0,0,0,8"
                         Background="Transparent" BorderThickness="0"
                         AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="InputTextBox_KeyDown"
                         FontFamily="Lora, Georgia, SimSun, Segoe UI">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="Transparent">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Panel.ZIndex="1"/>
                                    <TextBlock x:Name="PlaceholderText"
                                               Text="{x:Static res:Strings.AiPanel_InputPlaceholder}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="14.5"
                                               FontFamily="Lora, Georgia, SimSun, Segoe UI"
                                               Padding="{TemplateBinding Padding}"
                                               Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- 底部工具栏 -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- 附件 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 模式 -->
                        <ColumnDefinition Width="*"/>     <!-- 模型 (占满剩余空间，自动限制最大宽度) -->
                        <ColumnDefinition Width="Auto"/>  <!-- 发送 -->
                    </Grid.ColumnDefinitions>

                    <!-- 附件按钮 -->
                    <Button Grid.Column="0" x:Name="AttachButton" Click="AttachButton_Click"
                            Style="{StaticResource ToolbarButton}" Padding="4,2" Margin="0,0,8,0"
                            ToolTip="添加图片或文件">
                        <TextBlock Text="📎" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,2"/>
                    </Button>

                    <!-- 模式选择 -->
                    <ComboBox Grid.Column="1" x:Name="ModeComboBox"
                              SelectionChanged="ModeComboBox_SelectionChanged"
                              Style="{StaticResource FlatComboBoxStyle}"
                              Margin="0,0,8,0"
                              ToolTip="切换 AI 工作模式">
                        <ComboBoxItem Content="Design" Tag="0"/>
                        <ComboBoxItem Content="Autonomous" Tag="1"/>
                    </ComboBox>

                    <!-- 模型选择 -->
                    <ComboBox Grid.Column="2" x:Name="ModelComboBox"
                              SelectionChanged="ModelComboBox_SelectionChanged"
                              Style="{StaticResource FlatComboBoxStyle}"
                              HorizontalAlignment="Left"
                              Margin="0,0,8,0"/>

                    <!-- 发送按钮 -->
                    <Button Grid.Column="3" x:Name="SendButton" Click="SendButton_Click"
                            IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                            Width="28" Height="28" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource PrimaryButtonBgBrush}" CornerRadius="6">
                                    <TextBlock x:Name="BtnText" Text="↑" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryButtonTextBrush}" FontSize="16" FontWeight="Bold" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
                                        <Setter TargetName="BtnText" Property="Text" Value="■"/>
                                        <Setter TargetName="BtnText" Property="FontSize" Value="15"/>
                                        <Setter TargetName="BtnText" Property="Margin" Value="0"/>
                                        <Setter Property="ToolTip" Value="中断生成"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAiExecuting}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
                                        <Setter TargetName="BtnText" Property="Text" Value="■"/>
                                        <Setter TargetName="BtnText" Property="FontSize" Value="15"/>
                                        <Setter TargetName="BtnText" Property="Margin" Value="0"/>
                                        <Setter Property="ToolTip" Value="中断 AI 自主执行"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

