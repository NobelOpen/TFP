<Window x:Class="TaskFlow.Views.Dialogs.AnthropicMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=" "
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="{StaticResource FontBody}"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">

    <Window.Resources>
        <!-- 按钮基础样式 -->
        <Style x:Key="MsgBtnBase" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="MsgBtnPrimary" TargetType="Button" BasedOn="{StaticResource MsgBtnBase}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
        </Style>

        <!-- 次按钮样式 -->
        <Style x:Key="MsgBtnSecondary" TargetType="Button" BasedOn="{StaticResource MsgBtnBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- 危险按钮样式 -->
        <Style x:Key="MsgBtnDanger" TargetType="Button" BasedOn="{StaticResource MsgBtnBase}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}"/>
        </Style>
    </Window.Resources>

    <!-- 外层阴影边框 -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource CardShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 图标+标题 -->
                <RowDefinition Height="Auto"/>  <!-- 消息内容 -->
                <RowDefinition Height="Auto"/>  <!-- 分隔线 -->
                <RowDefinition Height="Auto"/>  <!-- 按钮区 -->
            </Grid.RowDefinitions>

            <!-- 标题区域 -->
            <StackPanel Orientation="Horizontal" Margin="24,22,24,0">
                <!-- 图标区 -->
                <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource DangerButtonHoverBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <!-- 警告图标 (!) -->
                    <TextBlock x:Name="IconText" Text="!" 
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource DangerButtonTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 标题 -->
                <TextBlock x:Name="TitleText" Text="提示"
                           FontSize="16" FontWeight="SemiBold"
                           FontFamily="{StaticResource FontTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 消息内容 -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Text="消息内容"
                       FontSize="13.5" LineHeight="21"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="24,14,24,20"/>

            <!-- 分隔线 -->
            <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderLightBrush}" Margin="0,0,0,0"/>

            <!-- 按钮区 -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="24,16,24,18">
                <!-- 按钮由代码动态添加 -->
            </StackPanel>
        </Grid>
    </Border>
</Window>
