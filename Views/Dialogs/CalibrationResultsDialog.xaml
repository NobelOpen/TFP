<Window x:Class="TaskFlow.Views.Dialogs.CalibrationResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标定结果" Width="620" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Text="Vision 坐标标定记录" Foreground="#d97757" FontSize="14"
                   FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- 列表 -->
        <DataGrid Grid.Row="1" x:Name="CalibrationGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="White" BorderBrush="#e8e6dc" BorderThickness="1"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f0efe8"
                  HeadersVisibility="Column" SelectionMode="Single"
                  FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#f5f4f0"/>
                    <Setter Property="Foreground" Value="#6b6a65"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="BorderBrush" Value="#e8e6dc"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="模型" Binding="{Binding ModelId}" Width="120"/>
                <DataGridTextColumn Header="分辨率" Binding="{Binding Width, StringFormat={}{0}x}" Width="50"/>
                <DataGridTextColumn Header="" Binding="{Binding Height}" Width="40"/>
                <DataGridTextColumn Header="ScaleX" Binding="{Binding ScaleX, StringFormat=F4}" Width="65"/>
                <DataGridTextColumn Header="ScaleY" Binding="{Binding ScaleY, StringFormat=F4}" Width="65"/>
                <DataGridTextColumn Header="OffsetX" Binding="{Binding OffsetX, StringFormat=F1}" Width="60"/>
                <DataGridTextColumn Header="OffsetY" Binding="{Binding OffsetY, StringFormat=F1}" Width="60"/>
                <DataGridTextColumn Header="误差px" Binding="{Binding AvgError, StringFormat=F1}" Width="55"/>
                <DataGridTextColumn Header="标定时间" Binding="{Binding CalibratedAt, StringFormat=MM-dd HH:mm}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="删除所选" Click="DeleteSelected_Click"
                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                    Background="#e8e6dc" Foreground="#141413" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dddbd2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="全部清除" Click="ClearAll_Click"
                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                    Background="#e8e6dc" Foreground="#141413" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dddbd2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="关闭" Click="Close_Click" IsCancel="True"
                    Padding="12,6" Cursor="Hand"
                    Background="#141413" Foreground="#faf9f5" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2a2a28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
