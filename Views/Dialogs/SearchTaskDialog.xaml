<Window x:Class="TaskFlow.Views.Dialogs.SearchTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找任务" 
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 查找按钮样式 -->
        <Style x:Key="SearchBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#d97757"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#c4663e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#b55a35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮样式 -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3a3a4a"/>
            <Setter Property="Foreground" Value="#f5f0eb"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2e2e3c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242432"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 输入框 -->
        <TextBlock x:Name="TxtSearchLabel" Grid.Row="0" Text="输入编号或名称" Foreground="#6b6a65" FontSize="12" Margin="0,0,0,6"/>
        
        <TextBox x:Name="SearchTextBox" Grid.Row="1"
                 Height="32" FontSize="14"
                 Background="White" Foreground="#141413"
                 BorderBrush="#e8e6dc" Padding="8,4"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchTextBox_TextChanged"
                 PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>

        <!-- 补全建议列表 -->
        <ListBox x:Name="SuggestionList" Grid.Row="2"
                 MaxHeight="180" Margin="0,4,0,0"
                 Background="#faf9f5" Foreground="#141413"
                 BorderBrush="#e8e6dc" BorderThickness="1"
                 Visibility="Collapsed"
                 FontSize="13"
                 PreviewMouseLeftButtonUp="SuggestionList_MouseClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#f5e6de"/>
                                        <Setter Property="Foreground" Value="#d97757"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#f0efe8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnSearch" Content="查找" Width="80" Height="32" Margin="0,0,8,0"
                    Click="SearchButton_Click" Style="{StaticResource SearchBtnStyle}"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="32"
                    Click="CloseButton_Click" Style="{StaticResource CancelBtnStyle}"/>
        </StackPanel>
    </Grid>
</Window>
