<Window x:Class="TaskFlow.Views.Dialogs.VariableManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变量管理" 
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="VarButton" TargetType="Button">
            <Setter Property="Background" Value="#f0efe8"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e8e6dc"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VarButtonRed" TargetType="Button" BasedOn="{StaticResource VarButton}">
            <Setter Property="Background" Value="#c45b4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d06b5a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VarButtonDark" TargetType="Button" BasedOn="{StaticResource VarButton}">
            <Setter Property="Background" Value="#141413"/>
            <Setter Property="Foreground" Value="#faf9f5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2a28"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TxtVarsTitle" Text="全局变量管理" 
                   Foreground="#d97757" 
                   FontSize="16" 
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource FontTitle}"
                   Margin="0,0,0,12"/>

        <!-- 变量列表 -->
        <DataGrid x:Name="VariableGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  Background="Transparent"
                  Foreground="#141413"
                  RowBackground="#faf9f5"
                  AlternatingRowBackground="#f5f4ee"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="13"
                  RowHeight="34"
                  CellEditEnding="VariableGrid_CellEditEnding">
            <DataGrid.Resources>
                <!-- 去除焦点虚线框 -->
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#f0efe8"/>
                    <Setter Property="Foreground" Value="#8a8880"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="#e8e6dc" BorderThickness="0,0,0,1">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#141413"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#e6ddd5"/>
                            <Setter Property="Foreground" Value="#141413"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#ede9e2"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#e6ddd5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Header="变量名" Binding="{Binding Name}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColType" Header="类型" Binding="{Binding Type}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColValue" Header="当前值" Binding="{Binding Value}" Width="*">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#d97757"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Content="添加" Click="AddVariable_Click" Style="{StaticResource VarButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnRename" Content="重命名" Click="RenameVariable_Click" Style="{StaticResource VarButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnDelete" Content="删除" Click="DeleteVariable_Click" Style="{StaticResource VarButtonRed}" Margin="0,0,8,0"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="BtnClose" Content="关闭" 
                Click="Close_Click" 
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Style="{StaticResource VarButtonDark}"/>
    </Grid>
</Window>

