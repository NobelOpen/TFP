<Window x:Class="TaskFlow.Views.Dialogs.ModelManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM 模型管理" 
        Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="ModelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonRed" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonDark" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonGreen" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CreamyWhiteBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonBlue" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Anthropic 浅色极简滚动条样式 -->
        <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="{DynamicResource BorderDarkColor}"/>
        <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="{DynamicResource TextTertiaryColor}"/>
        <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="{DynamicResource TextSecondaryColor}"/>

        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <!-- 外层阴影边框 -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource CardShadowColor}"/>
        </Border.Effect>

        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Margin="0,0,0,12">
            <TextBlock x:Name="TxtModelsTitle" Text="全局模型管理" 
                       Foreground="{DynamicResource DialogTitleBrush}" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource FontTitle}"
                       VerticalAlignment="Center"/>
            <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,-8,0"
                    Click="CloseBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 模型列表 -->
        <DataGrid x:Name="ModelGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowBackground="{DynamicResource AppBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="13"
                  RowHeight="34"
                  IsReadOnly="True"
                  SelectionChanged="ModelGrid_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColDisplayName" Header="显示名称" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="API Endpoint" Binding="{Binding ApiEndpoint}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColTokens" Header="Token 统计" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="共 {0:N0} (入:{1:N0} 出:{2:N0})">
                            <Binding Path="TotalTokens"/>
                            <Binding Path="TotalInputTokens"/>
                            <Binding Path="TotalOutputTokens"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Content="添加模型" Click="AddBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnDelete" Content="删除模型" Click="DeleteBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnEdit" Content="修改模型" Click="EditBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnTest" Content="测试连接" Click="TestBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnReset" Content="重置统计" Click="ResetStatsBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0" IsEnabled="False"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="BtnClose" Content="关闭" 
                Click="CloseBtn_Click" 
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Style="{StaticResource ModelButtonDark}"/>
        <!-- 中心加载遮罩 -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" CornerRadius="12" Margin="-16" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="{DynamicResource CardShadowColor}"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✦" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="正在测试中，请稍候..." FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>
