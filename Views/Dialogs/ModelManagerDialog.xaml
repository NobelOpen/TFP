<Window x:Class="TaskFlow.Views.Dialogs.ModelManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM 模型管理" 
        Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ModelButton" TargetType="Button">
            <Setter Property="Background" Value="#f0efe8"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e8e6dc"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonRed" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="#c45b4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d06b5a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonDark" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="#141413"/>
            <Setter Property="Foreground" Value="#faf9f5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2a28"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonGreen" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="#447821"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#558f2c"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelButtonBlue" TargetType="Button" BasedOn="{StaticResource ModelButton}">
            <Setter Property="Background" Value="#3878b5"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a8ec8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TxtModelsTitle" Text="全局模型管理" 
                   Foreground="#d97757" 
                   FontSize="16" 
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource FontTitle}"
                   Margin="0,0,0,12"/>

        <!-- 模型列表 -->
        <DataGrid x:Name="ModelGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  Background="Transparent"
                  Foreground="#141413"
                  RowBackground="#faf9f5"
                  AlternatingRowBackground="#f5f4ee"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="13"
                  RowHeight="34"
                  IsReadOnly="True"
                  SelectionChanged="ModelGrid_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#f0efe8"/>
                    <Setter Property="Foreground" Value="#8a8880"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="#e8e6dc" BorderThickness="0,0,0,1">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#141413"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#e6ddd5"/>
                            <Setter Property="Foreground" Value="#141413"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#ede9e2"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#e6ddd5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColDisplayName" Header="显示名称" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="API Endpoint" Binding="{Binding ApiEndpoint}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColTokens" Header="Token 统计" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="共 {0:N0} (入:{1:N0} 出:{2:N0})">
                            <Binding Path="TotalTokens"/>
                            <Binding Path="TotalInputTokens"/>
                            <Binding Path="TotalOutputTokens"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Content="添加模型" Click="AddBtn_Click" Style="{StaticResource ModelButtonGreen}" Margin="0,0,8,0"/>
            <Button x:Name="BtnEdit" Content="修改模型" Click="EditBtn_Click" Style="{StaticResource ModelButton}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnDelete" Content="删除模型" Click="DeleteBtn_Click" Style="{StaticResource ModelButtonRed}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnTest" Content="测试连接" Click="TestBtn_Click" Style="{StaticResource ModelButtonBlue}" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnReset" Content="重置统计" Click="ResetStatsBtn_Click" Style="{StaticResource ModelButtonBlue}" Margin="0,0,8,0" IsEnabled="False"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="BtnClose" Content="关闭" 
                Click="CloseBtn_Click" 
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Style="{StaticResource ModelButtonDark}"/>
    </Grid>
</Window>
