<Window x:Class="TaskFlow.Views.Dialogs.OnnxModelManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视觉模型管理" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="OnnxButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnnxButtonRed" TargetType="Button" BasedOn="{StaticResource OnnxButton}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnnxButtonDark" TargetType="Button" BasedOn="{StaticResource OnnxButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OnnxTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外框圆角容器 -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource CardShadowColor}"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区域 -->
            <Grid Margin="0,0,0,12">
                <TextBlock x:Name="TxtModelsTitle" Text="视觉模型管理" 
                           Foreground="{DynamicResource DialogTitleBrush}" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontTitle}"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                        Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,-8,0"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 模型列表 -->
            <DataGrid x:Name="ModelGrid" 
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource AppBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      FontSize="13"
                      RowHeight="34"
                      IsReadOnly="True"
                      SelectionChanged="ModelGrid_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Header="名称" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn x:Name="ColFile" Header="文件" Binding="{Binding FileName}" Width="140" />
                    <DataGridTextColumn x:Name="ColSize" Header="输入尺寸" Width="80">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0}×{1}">
                                <Binding Path="InputWidth"/>
                                <Binding Path="InputHeight"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColClasses" Header="类别数" Binding="{Binding ClassCount}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 编辑区：选中模型后可编辑属性 -->
            <Border x:Name="EditPanel" Grid.Row="2" Margin="0,12,0,12" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 名称 -->
                    <TextBlock Text="名称" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="TxtDisplayName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6"
                             Style="{StaticResource OnnxTextBox}"/>

                    <!-- 输入尺寸 & 置信度 -->
                    <TextBlock Text="输入尺寸" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="TxtInputW" Width="60" Style="{StaticResource OnnxTextBox}" Margin="0,0,4,0"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtInputH" Width="60" Style="{StaticResource OnnxTextBox}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="置信度" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="TxtConfidence" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"
                             Style="{StaticResource OnnxTextBox}"/>

                    <!-- 类别标签 -->
                    <TextBlock Text="类别标签" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="TxtLabels" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6"
                             Style="{StaticResource OnnxTextBox}" ToolTip="逗号分隔，如 player,enemy,item"/>

                    <!-- 保存按钮 -->
                    <Button x:Name="BtnSaveEdit" Content="保存修改" Grid.Row="3" Grid.Column="3"
                            Style="{StaticResource OnnxButtonDark}" Click="SaveEdit_Click"
                            Padding="10,4" FontSize="12"/>
                </Grid>
            </Border>

            <!-- 底部操作按钮 -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0,12,0,0">
                <Button x:Name="BtnImport" Content="导入" Style="{StaticResource OnnxButton}" Click="Import_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnEdit" Content="编辑" Style="{StaticResource OnnxButton}" Click="Edit_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="BtnDelete" Content="删除" Style="{StaticResource OnnxButton}" Click="Delete_Click" IsEnabled="False" Margin="0,0,8,0"/>
            </StackPanel>

            <Button Grid.Row="3" 
                    x:Name="BtnClose" Content="确定" 
                    Click="Close_Click" 
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Style="{StaticResource OnnxButtonDark}"/>
        </Grid>
    </Border>
</Window>
