<Window x:Class="TaskFlow.Views.Dialogs.CustomScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="自定义脚本编辑器" 
        Width="900" Height="650"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- 工具栏按钮样式 -->
        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 工具栏层 -->
            <RowDefinition Height="Auto"/>
            <!-- 代码层 -->
            <RowDefinition Height="*"/>
            <!-- 分隔条 -->
            <RowDefinition Height="Auto"/>
            <!-- 输出层 -->
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- 工具栏层 -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="❔ 帮助" Style="{StaticResource ToolBarButton}" Click="Help_Click" ToolTip="打开官方接口文档"/>
                <Rectangle Width="1" Fill="#3F3F46" Margin="6,2"/>
                <Button Content="💾 保存" Style="{StaticResource ToolBarButton}" Click="Save_Click" ToolTip="保存代码到卡片"/>
                <Button Content="📥 另存为" Style="{StaticResource ToolBarButton}" Click="SaveAs_Click" ToolTip="导出为 .cs 文件"/>
                <Button Content="📂 读取" Style="{StaticResource ToolBarButton}" Click="Load_Click" ToolTip="从 .cs 文件导入"/>
                <Rectangle Width="1" Fill="#3F3F46" Margin="6,2"/>
                <Button Content="💬 注释" Style="{StaticResource ToolBarButton}" Click="Comment_Click" ToolTip="注释选中行 (Ctrl+/)"/>
                <Button Content="📝 取消注释" Style="{StaticResource ToolBarButton}" Click="Uncomment_Click" ToolTip="取消注释选中行 (Ctrl+/)"/>
                <Rectangle Width="1" Fill="#3F3F46" Margin="6,2"/>
                <Button Content="▶ 运行" Style="{StaticResource ToolBarButton}" Click="Run_Click" 
                        Foreground="#4EC9B0" FontWeight="Bold" ToolTip="执行脚本并查看输出"/>
            </StackPanel>
        </Border>

        <!-- 代码编辑器层：AvalonEdit -->
        <avalonEdit:TextEditor
            x:Name="CodeEditor"
            Grid.Row="1"
            SyntaxHighlighting="C#"
            ShowLineNumbers="True"
            FontFamily="Consolas"
            FontSize="14"
            Background="#1E1E1E"
            Foreground="#D4D4D4"
            LineNumbersForeground="#858585"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            PreviewKeyDown="CodeEditor_PreviewKeyDown"
            Padding="4"/>

        <!-- 可拖拽的分隔条 -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" 
                      Background="#3F3F46" ResizeDirection="Rows"/>

        <!-- 输出面板层 -->
        <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 输出" Foreground="#858585" FontSize="12" 
                           Margin="8,4" FontWeight="Bold"/>
                <TextBox x:Name="OutputPanel"
                         Grid.Row="1"
                         IsReadOnly="True"
                         Background="#0E0E0E"
                         Foreground="#4EC9B0"
                         FontFamily="Consolas"
                         FontSize="13"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
