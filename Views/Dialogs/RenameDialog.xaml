<Window x:Class="TaskFlow.Views.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" 
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 确定按钮样式 -->
        <Style x:Key="OkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#d97757"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#c4663e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#b55a35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮样式 -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3a3a4a"/>
            <Setter Property="Foreground" Value="#f5f0eb"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2e2e3c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242432"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtNewNameLabel" Grid.Row="0" Text="任务名称" Foreground="#6b6a65" FontSize="12" Margin="0,0,0,6"/>
        
        <TextBox x:Name="NameTextBox" 
                 Grid.Row="1"
                 MinHeight="36" FontSize="14"
                 Background="White" Foreground="#141413"
                 BorderBrush="#e8e6dc" BorderThickness="1"
                 Padding="8,8"
                 VerticalContentAlignment="Center">
            <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnOK" Content="确定" Width="80" Height="32" Margin="0,0,8,0"
                    Click="OkButton_Click" Style="{StaticResource OkBtnStyle}"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="32"
                    Click="CancelButton_Click" Style="{StaticResource CancelBtnStyle}"/>
        </StackPanel>
    </Grid>
</Window>
