<Window x:Class="TaskFlow.Views.Dialogs.ModelEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑模型" 
        Height="580" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButtonDark" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButtonGreen" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CreamyWhiteBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Anthropic 浅色极简滚动条样式 -->
        <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="{DynamicResource BorderDarkColor}"/>
        <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="{DynamicResource TextTertiaryColor}"/>
        <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="{DynamicResource TextSecondaryColor}"/>

        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <!-- 外层阴影边框 -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource CardShadowColor}"/>
        </Border.Effect>

    <DockPanel Margin="16">
        <!-- 标题区域 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{DynamicResource DialogTitleBrush}" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource FontTitle}"
                       VerticalAlignment="Center"/>
            <Button Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" 
                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="18" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,-8,0"
                    Click="CancelBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,16,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="保存" Click="SaveBtn_Click" Style="{StaticResource DialogButtonDark}" Width="80"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,10,0">
                <TextBlock x:Name="TxtDisplayNameLabel" Text="显示名称" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDisplayName" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>

                <TextBlock Text="API Endpoint" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtApiEndpoint" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="TxtApiHint" Text="例如：https://api.openai.com/v1/chat/completions" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>

                <TextBlock Text="API Key" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtApiKey" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                
                <TextBlock x:Name="TxtModelNameLabel" Text="实际模型名 (Model Name)" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtModelName" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="TxtModelNameHint" Text="例如：gpt-4o, gpt-3.5-turbo" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>

                <TextBlock x:Name="TxtTimeoutLabel" Text="超时时间 (秒)" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtTimeout" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>

                <TextBlock x:Name="TxtCustomHeadersLabel" Text="自定义请求头" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtCustomHeaders" Style="{StaticResource PropTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="TxtCustomHeadersHint" Text="每行一个，格式 Key: Value（如 Host: example.com）" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>

                <!-- API 代理设置 -->
                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🛡 API 代理" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtProxyStatus" Text="" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="部分 API 需要通过本地代理绕过 Cloudflare TLS 指纹检测（需 Node.js）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ChkUseProxy" Content="启用 API 代理" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,6"
                                  Checked="ChkUseProxy_Changed" Unchecked="ChkUseProxy_Changed"/>
                        <StackPanel x:Name="PanelProxyConfig" Visibility="Collapsed">
                            <TextBlock Text="代理目标域名:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtProxyTargetHost" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                            <TextBlock Text="填写需要代理的域名（如 api.312800.xyz），端口号由系统自动分配" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 快捷导入 -->
                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="✦ 从代码快捷导入" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="粘贴通过 OpenAI SDK 调用大模型的 Python 代码，将自动提取并填充上方配置" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="TxtQuickImport" Style="{StaticResource PropTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="TxtQuickImport_TextChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</Window>
