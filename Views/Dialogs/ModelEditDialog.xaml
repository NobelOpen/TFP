<Window x:Class="TaskFlow.Views.Dialogs.ModelEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑模型" 
        Height="480" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#faf9f5"
        FontFamily="{StaticResource FontBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="BorderBrush" Value="#e8e6dc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#f0efe8"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e8e6dc"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButtonDark" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#141413"/>
            <Setter Property="Foreground" Value="#faf9f5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2a28"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButtonGreen" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#447821"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#558f2c"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Anthropic 浅色极简滚动条样式 -->
        <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#f0efe8"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#c8c6be"/>
        <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#b0aea5"/>
        <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#8a8880"/>

        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollBar.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScrollBar.Static.Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 减小滚动条宽度到 10px -->
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- 移除上下箭头按钮，让轨道占满 -->
                            <!-- IsEnabled 固定为 true，避免拖拽时鼠标移出滚动条区域导致 Track 被禁用而卡顿 -->
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- 赋予 Thumb 视觉反馈 -->
                                    <Thumb Style="{StaticResource DarkScrollThumbStyle}" Background="{StaticResource ScrollBar.Static.Thumb}" x:Name="Thumb"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource ScrollBar.MouseOver.Thumb}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true" SourceName="Thumb">
                                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource ScrollBar.Pressed.Thumb}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,10,0">
                <TextBlock x:Name="TxtDisplayNameLabel" Text="显示名称" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDisplayName" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>

                <TextBlock Text="API Endpoint" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtApiEndpoint" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="TxtApiHint" Text="例如：https://api.openai.com/v1/chat/completions" FontSize="11" Foreground="#b0aea5" Margin="0,2,0,0"/>

                <TextBlock Text="API Key" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtApiKey" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                
                <TextBlock x:Name="TxtModelNameLabel" Text="实际模型名 (Model Name)" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtModelName" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="TxtModelNameHint" Text="例如：gpt-4o, gpt-3.5-turbo" FontSize="11" Foreground="#b0aea5" Margin="0,2,0,0"/>

                <TextBlock x:Name="TxtTimeoutLabel" Text="超时时间 (秒)" Style="{StaticResource PropLabel}"/>
                <TextBox x:Name="TxtTimeout" Style="{StaticResource PropTextBox}" TextChanged="Field_TextChanged"/>

                <!-- 快捷导入 -->
                <Border Background="#f0efe8" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="✦ 从代码快捷导入" Foreground="#141413" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="粘贴通过 OpenAI SDK 调用大模型的 Python 代码，将自动提取并填充上方配置" FontSize="11" Foreground="#8a8880" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="TxtQuickImport" Style="{StaticResource PropTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="TxtQuickImport_TextChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#e8e6dc" Margin="0,16,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="保存" Click="SaveBtn_Click" Style="{StaticResource DialogButtonGreen}" Width="80" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancel" Content="取消" Click="CancelBtn_Click" Style="{StaticResource DialogButtonDark}" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
