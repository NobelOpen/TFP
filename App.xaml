<Application x:Class="TaskFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskFlow"
             xmlns:conv="clr-namespace:TaskFlow.Converters"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ====== 自定义字体资源 ====== -->
        <!-- 正文字体：西文 Source Serif 4 + 中文 Noto Serif SC -->
        <FontFamily x:Key="FontBody">pack://application:,,,/Fonts/#Source Serif 4</FontFamily>
        <!-- 标题字体：Cormorant Garamond（古典优雅） -->
        <FontFamily x:Key="FontTitle">pack://application:,,,/Fonts/#Cormorant Garamond</FontFamily>
        <!-- 等宽字体：代码和日志使用 -->
        <FontFamily x:Key="FontMono">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

        <!-- 全局默认字体：所有 Window 及其子控件自动继承正文字体 -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        </Style>

        <!-- 全局转换器 -->
        <conv:TaskStatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:SelectedToBorderColorConverter x:Key="SelectedToBorderConverter"/>
        <conv:CollapseIconConverter x:Key="CollapseIconConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <conv:CollapseIconVisibilityConverter x:Key="CollapseIconVisConverter"/>
        <conv:DragHandleVisibilityConverter x:Key="DragHandleVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:MatToBitmapSourceConverter x:Key="MatToImageConverter"/>
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>

        <!-- Anthropic 风格工具栏按钮-->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#faf9f5"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e3dacc" />
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e8e6dc"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToolbarButtonGreen" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#788c5d"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8a9e6d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToolbarButtonRed" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#c45b4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d06b5a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToolbarButtonDark" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#141413"/>
            <Setter Property="Foreground" Value="#faf9f5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2a28"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="VerticalSeparator" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="#e8e6dc"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Width="1" Fill="#e8e6dc"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Anthropic 风格右键菜单 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e8e6dc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#b0aea5" BlurRadius="12" ShadowDepth="2" Opacity="0.18" Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Anthropic 风格菜单项（支持子菜单） -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#141413"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="MenuBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" 
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <!-- 子菜单箭头 -->
                                    <Path x:Name="SubMenuArrow"
                                          Grid.Column="1"
                                          Data="M 0,0 L 4,4 L 0,8"
                                          Fill="#b0aea5"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- 子菜单弹出面板 -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        BorderBrush="#e8e6dc"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#b0aea5" BlurRadius="12" ShadowDepth="2" Opacity="0.18" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#f0efe8"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#b0aea5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 菜单中的分隔线 -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#e8e6dc"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
