<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskFlow"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        xmlns:conv="clr-namespace:TaskFlow.Converters"
        xmlns:models="clr-namespace:TaskFlow.Models.TaskCards"
        xmlns:panels="clr-namespace:TaskFlow.Views.Panels"
        xmlns:res="clr-namespace:TaskFlow.Resources"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="640" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

    <!-- WindowChrome：保留原生拖拽/缩放/Snap Layout，允许自定义标题栏内容 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <conv:TaskStatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:SelectedToBorderColorConverter x:Key="SelectedToBorderConverter"/>
        <conv:CollapseIconConverter x:Key="CollapseIconConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <conv:CollapseIconVisibilityConverter x:Key="CollapseIconVisConverter"/>
        <conv:DragHandleVisibilityConverter x:Key="DragHandleVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:MatToBitmapSourceConverter x:Key="MatToImageConverter"/>
        <conv:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
        <conv:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter"/>
        <conv:ScrollableToVisibilityConverter x:Key="ScrollableToVisConverter"/>
        
        <!-- ListBoxItem 透明样式，去除默认选中高亮 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 任务卡片模板 — 精简版（减少元素数量以提升虚拟化性能） -->
        <conv:TaskStatusToIconConverter x:Key="StatusToIconConverter"/>
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TaskCardBase}">
            <Border x:Name="CardBorder"
                    Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="1.5"
                    ClipToBounds="True"
                    CacheMode="BitmapCache"
                    Cursor="Hand"
                    Visibility="{Binding IsHiddenByCollapse, Converter={StaticResource InverseBoolToVisConverter}}"
                    MouseLeftButtonDown="TaskCard_MouseLeftButtonDown"
                    MouseMove="TaskCard_MouseMove"
                    AllowDrop="True"
                    Drop="TaskCard_Drop"
                    DragOver="TaskCard_DragOver"
                    MouseRightButtonUp="TaskCard_MouseRightButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- 外层 Grid，方便放置左侧彩色线条与右侧内容容器 -->
                <Grid>
                    <!-- 左侧状态指示线 -->
                    <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Margin="6,10,0,10" CornerRadius="1.5"
                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                    
                    <!-- 原来的内层容器，代替在 CardBorder 上的 Padding -->
                    <Grid Margin="16,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    
                    <!-- 折叠按钮 + 拖拽手柄 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IsCollapsed, Converter={StaticResource CollapseIconConverter}}"
                                   Visibility="{Binding BranchRole, Converter={StaticResource CollapseIconVisConverter}}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="≡" 
                                   FontSize="18" 
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Cursor="SizeAll">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource DragHandleVisConverter}">
                                    <Binding Path="BranchRole"/>
                                    <Binding Path="IsCollapsed"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 任务信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" 
                                   FontFamily="Georgia, SimSun"
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"/>
                        <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0">
                            <Run Text="#"/>
                            <Run Text="{Binding Order, Mode=OneWay}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding TaskTypeName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 状态指示（同时绑定图标和强调色） -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- 自定义标题栏 -->
                <RowDefinition Height="50"/> <!-- 工具栏 -->
                <RowDefinition Height="*"/>  <!-- 主内容 -->
            </Grid.RowDefinitions>

            <!-- ====== 自定义标题栏 ====== -->
            <Grid Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题文字（可拖拽区域，由 WindowChrome CaptionHeight 控制） -->
                <TextBlock Text="{Binding WindowTitle}"
                           FontFamily="Georgia, SimSun"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- 主题切换 -->
                    <Button Click="TitleBar_ThemeToggle_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="切换主题 / Theme">
                        <TextBlock x:Name="ThemeIconText" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 最小化 -->
                    <Button Click="TitleBar_Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Main_Minimize}">
                        <TextBlock Text="─" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 最大化/还原 -->
                    <Button x:Name="TitleBarMaxRestoreBtn" Click="TitleBar_MaxRestore_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Main_Maximize}">
                        <TextBlock x:Name="TitleBarMaxRestoreIcon" Text="☐" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 关闭 -->
                    <Button Click="TitleBar_Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Common_Close}">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 顶部工具栏 -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="8,2,8,2">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="8" ShadowDepth="3" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 左侧文件操作 -->
                        <ColumnDefinition Width="*"/>    <!-- 中间收纳操作 -->
                        <ColumnDefinition Width="Auto"/> <!-- 右侧运行操作 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧核心 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NewProjectCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_NewProject}"/></StackPanel></Button>
                        <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_SaveProject}"/></StackPanel></Button>
                        <Button Command="{Binding SaveAsCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE792; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_SaveAs}"/></StackPanel></Button>
                        <Button Command="{Binding LoadCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_Load}"/></StackPanel></Button>
                        <Separator Style="{StaticResource VerticalSeparator}"/>
                    </StackPanel>

                    <!-- 中间弹性收纳区 -->
                    <ToolBarTray Grid.Column="1" Background="Transparent" IsLocked="True" VerticalAlignment="Center">
                        <ToolBar x:Name="MainToolBar" Style="{DynamicResource FlatToolBar}"  MinHeight="0" Padding="0,0,0,0" ToolBarTray.IsLocked="True">
                            <!-- Button在ToolBar中默认样式会被覆盖，必须显式指定Style -->
                            <Button Click="HideToTray_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="🔽 "/><TextBlock Text="{x:Static res:Strings.Main_Hide}"/></StackPanel></Button>
                            <Button Click="OpenSettings_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_Settings}"/></StackPanel></Button>
                            <Button Click="ToggleAiPanel_Click" Style="{StaticResource ToolbarButton}" Margin="4,0" ToolTip="Orchid AI Assistant"><StackPanel Orientation="Horizontal"><TextBlock Text="✦ "/><TextBlock Text="Orchid"/></StackPanel></Button>
                            <Button Click="OpenVariableManager_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_Variables}"/></StackPanel></Button>
                            <Button Click="OpenFlowManager_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_Flows}"/></StackPanel></Button>
                            <Button Click="OpenModelManager_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9FA; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_Models}"/></StackPanel></Button>
                            <Button Click="OpenOnnxModelManager_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_VisionModels}"/></StackPanel></Button>
                            <Button Click="OpenHelp_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Common_Help}"/></StackPanel></Button>
                        </ToolBar>
                    </ToolBarTray>

                    <!-- 右侧核心 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Separator Style="{StaticResource VerticalSeparator}"/>
                        <Button Command="{Binding RunSelectedCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Main_RunOnce}"/></StackPanel></Button>
                        <!-- 运行组合按钮（带下拉切换运行当前/运行全部）— 深色一体化 -->
                        <Grid x:Name="RunModeGrid" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RunModeButton" 
                                    Command="{Binding RunCurrentFlowCommand}" 
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="12,6,4,6" Cursor="Hand" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RunModeIcon" Text="&#xE768; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RunModeText" Text="{x:Static res:Strings.Main_RunCurrent}"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,1,0,1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RunReadyButtonHoverBrush}"/>
                                            </MultiDataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource RunReadyButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton x:Name="RunModeDropdown" Grid.Column="1" 
                                          Click="RunModeDropdown_Click"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                          WindowChrome.IsHitTestVisibleInChrome="True"
                                          Cursor="Hand" Padding="4,6" BorderThickness="0">
                                <TextBlock x:Name="RunModeDropdownIcon" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,1,1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RunReadyButtonHoverBrush}"/>
                                            </MultiDataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="{DynamicResource RunReadyButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.ContextMenu>
                                    <ContextMenu x:Name="RunModeMenu">
                                        <MenuItem Header="{x:Static res:Strings.Main_RunCurrentFlow}" Click="RunModeCurrent_Click"/>
                                        <MenuItem Header="{x:Static res:Strings.Main_RunAllFlows}" Click="RunModeAll_Click"/>
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                        </Grid>
                        <Button x:Name="StopAllButton" Command="{Binding StopExecutionCommand}" Margin="4,0"
                                Padding="12,6" Cursor="Hand" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.Main_StopAll}"/>
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 非运行状态 hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsRunning}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </MultiDataTrigger>
                                        <!-- 运行状态 hover：橙色微深 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsRunning}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/>
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StopActiveButtonBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AiPanelColumn" Width="0"/>  <!-- AI 面板列（默认收起） -->
                <ColumnDefinition x:Name="AiPanelSplitterColumn" Width="0"/>  <!-- AI 面板分隔器 -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- AI 流程助手面板（默认收起） -->
            <panels:AiFlowPanel x:Name="AiFlowPanelControl" Grid.Column="0" Visibility="Collapsed" Margin="8,8,0,8"/>

            <!-- AI 面板分隔器 -->
            <GridSplitter x:Name="AiPanelSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed"/>

            <!-- 左侧任务卡片画布 -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Margin="8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderLightBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" Opacity="0.18" BlurRadius="8" ShadowDepth="3" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,0"/>

                    <!-- 左侧分页标签栏 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ScrollViewer x:Name="TabScrollViewer" Grid.Column="0"

                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl x:Name="FlowTabItemsControl" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name, Converter={StaticResource ToUpperConverter}}" 
                                            Click="TabItem_Click"
                                            Tag="{Binding}"
                                            Margin="2,0"
                                            Padding="10,4"
                                            MinWidth="100"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            FontSize="12">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="TabBd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="0"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    BorderThickness="0,0,0,2"
                                                                    BorderBrush="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent"
                                                                            CornerRadius="0"
                                                                            Padding="{TemplateBinding Padding}"
                                                                            BorderThickness="0,0,0,2"
                                                                            BorderBrush="Transparent">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            <!-- 流程标签滑动指示条 -->
                            <Border x:Name="FlowTabIndicator"
                                    Height="2" Background="{DynamicResource TitleUnderlineBrush}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Width="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="FlowTabIndicatorTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        </ScrollViewer>

                        
                        <!-- 向左滚动按钮 -->
                        <Button Grid.Column="1"
                                Content="◀" 
                                Click="TabScrollLeft_Click"
                                Visibility="{Binding ScrollableWidth, ElementName=TabScrollViewer, Converter={StaticResource ScrollableToVisConverter}}"
                                Width="20" Height="24" 
                                FontSize="10"
                                Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" 
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="4,0,0,0"
                                ToolTip="向左滚动">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- 向右滚动按钮 -->
                        <Button Grid.Column="2"
                                Content="▶" 
                                Click="TabScrollRight_Click"
                                Visibility="{Binding ScrollableWidth, ElementName=TabScrollViewer, Converter={StaticResource ScrollableToVisConverter}}"
                                Width="20" Height="24" 
                                FontSize="10"
                                Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" 
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="2,0,0,0"
                                ToolTip="向右滚动">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                    </Grid>

                        <!-- 流程画布容器：每个 Tab 拥有独立的 ListBox，切换时翻转 Visibility 实现瞬切 -->
                        <Grid Grid.Row="1">
                            <Grid x:Name="FlowCanvasHost">
                            <Grid.Resources>
                                <!-- 画布右键菜单（共享给所有动态 ListBox） -->
                                <ContextMenu x:Key="CanvasContextMenu">
                                    <MenuItem Header="{x:Static res:Strings.Main_SearchTask}" Click="SearchTask_Click" Tag="Search"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuPasteCanvas" Header="{x:Static res:Strings.Menu_Paste}" Click="PasteTask_Click" Tag="Paste"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static res:Strings.Main_AddTask}">
                                        <!-- 通用 -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_General}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_PauseTask}" Click="AddTask_Click" Tag="PauseTask"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_GetTimestamp}" Click="AddTask_Click" Tag="GetTimestamp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EndTask}" Click="AddTask_Click" Tag="EndTask"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EndAllFlows}" Click="AddTask_Click" Tag="EndAllFlows"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_RestartFlow}" Click="AddTask_Click" Tag="RestartFlow"/>
                                        </MenuItem>
                                        <!-- Windows -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_WinOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinLaunchApp}" Click="AddTask_Click" Tag="WinLaunchApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinScreenshot}" Click="AddTask_Click" Tag="WinScreenshot"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinClick}" Click="AddTask_Click" Tag="WinClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinCloseApp}" Click="AddTask_Click" Tag="WinCloseApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinUiAutomation}" Click="AddTask_Click" Tag="WinUiAutomation"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinSimulateInput}" Click="AddTask_Click" Tag="WinSimulateInput"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinSubtitle}" Click="AddTask_Click" Tag="WinSubtitle"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinFindFile}" Click="AddTask_Click" Tag="WinFindFile"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinTextInput}" Click="AddTask_Click" Tag="WinTextInput"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_InputCombo}" Click="AddTask_Click" Tag="InputCombo"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EventListener}" Click="AddTask_Click" Tag="EventListener"/>
                                        </MenuItem>
                                        <!-- ADB -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_AdbOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbConnect}" Click="AddTask_Click" Tag="AdbConnect"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbLaunchApp}" Click="AddTask_Click" Tag="AdbLaunchApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbScreenshot}" Click="AddTask_Click" Tag="AdbScreenshot"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbClick}" Click="AddTask_Click" Tag="AdbClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbCloseApp}" Click="AddTask_Click" Tag="AdbCloseApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbDisconnect}" Click="AddTask_Click" Tag="AdbDisconnect"/>
                                        </MenuItem>
                                        <!-- Image Processing -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_ImgProc}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgCrop}" Click="AddTask_Click" Tag="ImgCrop"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgTemplateMatch}" Click="AddTask_Click" Tag="ImgTemplateMatch"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgOnnxDetect}" Click="AddTask_Click" Tag="ImgOnnxDetect"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgCaliperMeasure}" Click="AddTask_Click" Tag="ImgCaliperMeasure"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgOcr}" Click="AddTask_Click" Tag="ImgOcr"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgColorDetect}" Click="AddTask_Click" Tag="ImgColorDetect"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgColorSegment}" Click="AddTask_Click" Tag="ImgColorSegment"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgPreprocess}" Click="AddTask_Click" Tag="ImgPreprocess"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgBlobAnalysis}" Click="AddTask_Click" Tag="ImgBlobAnalysis"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgResize}" Click="AddTask_Click" Tag="ImgResize"/>
                                        </MenuItem>
                                        <!-- Data Processing -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_DataProc}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ExpressionEval}" Click="AddTask_Click" Tag="ExpressionEval"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_StringSubstring}" Click="AddTask_Click" Tag="StringSubstring"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_TypeConvert}" Click="AddTask_Click" Tag="TypeConvert"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArrayParse}" Click="AddTask_Click" Tag="ArrayParse"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArrayBuilder}" Click="AddTask_Click" Tag="ArrayBuilder"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_FileRead}" Click="AddTask_Click" Tag="FileRead"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArraySearch}" Click="AddTask_Click" Tag="ArraySearch"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_CustomScript}" Click="AddTask_Click" Tag="CustomScript"/>
                                        </MenuItem>
                                        <!-- Browser -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_BrowserOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserGetText}" Click="AddTask_Click" Tag="BrowserGetText"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserExecuteJs}" Click="AddTask_Click" Tag="BrowserExecuteJs"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserWaitForElement}" Click="AddTask_Click" Tag="BrowserWaitForElement"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserNativeClick}" Click="AddTask_Click" Tag="BrowserNativeClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserNativeInput}" Click="AddTask_Click" Tag="BrowserNativeInput"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserSimulatedClick}" Click="AddTask_Click" Tag="BrowserSimulatedClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserCdpCommand}" Click="AddTask_Click" Tag="BrowserCdpCommand"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BrowserScreenshot}" Click="AddTask_Click" Tag="BrowserScreenshot"/>
                                        </MenuItem>
                                        <!-- AI -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_AiOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmTranslate}" Click="AddTask_Click" Tag="LlmTranslate"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmVision}" Click="AddTask_Click" Tag="LlmVision"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmFileTranslate}" Click="AddTask_Click" Tag="LlmFileTranslate"/>
                                        </MenuItem>
                                        <!-- Control Flow -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_ControlFlow}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BreakLoop}" Click="AddTask_Click" Tag="BreakLoop"/>
                                            <MenuItem Header="{x:Static res:Strings.Menu_IfElseBranch}" Click="AddBranch_Click" Tag="IfElse"/>
                                            <MenuItem Header="{x:Static res:Strings.Menu_ForLoop}" Click="AddBranch_Click" Tag="ForLoop"/>
                                            <Separator/>
                                            <MenuItem x:Name="MenuCallSubFlow" Header="{x:Static res:Strings.TaskType_CallSubFlow}" Click="AddTask_Click" Tag="CallSubFlow"/>
                                            <MenuItem x:Name="MenuSubFlowOutput" Header="{x:Static res:Strings.TaskType_SubFlowOutput}" Click="AddTask_Click" Tag="SubFlowOutput"/>
                                        </MenuItem>
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.Resources>
                                </Grid>

                                <!-- 空状态提示 -->
                                <TextBlock Text="{x:Static res:Strings.Main_EmptyHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding TaskCards.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}"/>
                        </Grid>
                </Grid>
            </Border>
            
            <!-- 分隔器 -->
            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            
            <!-- 右侧显示与通知区 -->
            <Grid Grid.Column="4" Margin="0,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 可切换显示窗口 -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource CardShadowColor}" Opacity="0.18" BlurRadius="8" ShadowDepth="3" Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,0"/>
                        
                        <!-- 标签切换按钮 -->
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="TopTabContainer">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PreviewTabButton" 
                                                 Content="{x:Static res:Strings.Main_ImagePreview}" 
                                                 IsChecked="True"
                                                 Checked="ImageTabButton_Checked"
                                                 Style="{DynamicResource TabToggleStyle}"
                                                 Tag="Preview"/>
                                    <RadioButton x:Name="LiveTabButton" 
                                                 Content="{x:Static res:Strings.Main_LiveView}" 
                                                 Checked="ImageTabButton_Checked"
                                                 Style="{DynamicResource TabToggleStyle}"
                                                 Tag="Live"/>
                                </StackPanel>
                                <!-- 上方标签滑动指示条 -->
                                <Border x:Name="TopTabIndicator"
                                        Height="2" Background="{DynamicResource TitleUnderlineBrush}"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left"
                                        Width="0" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TopTabIndicatorTransform"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <!-- 坐标文本（仅图像预览时有意义） -->
                            <TextBlock x:Name="ImageCoordinateText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 图像预览页面 -->
                        <Border x:Name="ImagePreviewPanel" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                            <Grid>
                                <!-- 无图像时居中显示文字 -->
                                <TextBlock Text="{x:Static res:Strings.Main_NoImageHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           FontFamily="Lora, Georgia, SimSun, Segoe UI"
                                           Visibility="{Binding DisplayImage, Converter={StaticResource NullToVisibleConverter}}"/>
                                <ScrollViewer x:Name="ImageScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent"
                                              SizeChanged="ImageScrollViewer_SizeChanged">
                                    <Image x:Name="PreviewImage"
                                           Source="{Binding DisplayImage, Converter={StaticResource MatToImageConverter}}"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseMove="PreviewImage_MouseMove"
                                           MouseLeave="PreviewImage_MouseLeave"
                                           MouseWheel="PreviewImage_MouseWheel">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                        <Image.ContextMenu>
                                            <ContextMenu ContextMenuOpening="PreviewContextMenu_Opening">
                                                <MenuItem Header="{x:Static res:Strings.Main_SaveImage}" Click="SavePreviewImage_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ResetSize}" Click="ResetImageSize_Click"/>
                                            </ContextMenu>
                                        </Image.ContextMenu>
                                    </Image>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- 实时显示页面 -->
                        <Border x:Name="LivePreviewPanel" Grid.Row="1" Background="Transparent" ClipToBounds="True" Visibility="Collapsed">
                            <Grid>
                                <!-- 实时画面（支持缩放和滚动） -->
                                <ScrollViewer x:Name="LiveScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                    <Image x:Name="LivePreviewImage"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseMove="LivePreviewImage_MouseMove"
                                           MouseLeave="LivePreviewImage_MouseLeave"
                                           MouseWheel="LivePreviewImage_MouseWheel">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="LiveImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                        <Image.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.Main_SaveImage}" Click="SaveLiveImage_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ResetSize}" Click="ResetLiveImageSize_Click"/>
                                            </ContextMenu>
                                        </Image.ContextMenu>
                                    </Image>
                                </ScrollViewer>
                                
                                <!-- 无内容提示 -->
                                <TextBlock x:Name="LivePreviewHint"
                                           Text="{x:Static res:Strings.Main_LiveStartHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           FontFamily="Lora, Georgia, SimSun, Segoe UI"/>
                                
                                <!-- 左下角浮动按钮组 -->
                                    <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                            Margin="8,0,0,8">
                                    <!-- 播放按钮 -->
                                    <Button x:Name="BtnLiveStart" Content="▶" Click="LivePreviewStart_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                            Width="28"  FontSize="22" Padding="0"
                                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                            ToolTip="开始实时显示">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 停止按钮 -->
                                    <Button x:Name="BtnLiveStop" Content="■" Click="LivePreviewStop_Click"
                                            Width="28" FontSize="22" Padding="0"
                                            Background="Transparent" Foreground="{DynamicResource CreamyWhiteBrush}" BorderThickness="0" Cursor="Hand"
                                            ToolTip="停止实时显示" Visibility="Collapsed">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 设置按钮 -->
                                    <Button x:Name="BtnLiveSettings" Content="◉" Click="LivePreviewSettings_Click"
                                        Width="28" Height="28" FontSize="22" Padding="0" VerticalAlignment="Center"
                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"  Cursor="Hand" 
                                        ToolTip="{x:Static res:Strings.Main_LiveSettings}" Margin="4,2,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 分隔器 -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                
                <!-- 可切换通知窗口 -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource CardShadowColor}" Opacity="0.18" BlurRadius="8" ShadowDepth="3" Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,0"/>
                        
                        <!-- 标签切换按钮 -->
                        <Grid x:Name="BottomTabContainer" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LogTabButton" 
                                             Content="{x:Static res:Strings.Main_RunLog}" 
                                             IsChecked="True"
                                             Checked="TabButton_Checked"
                                             Style="{DynamicResource TabToggleStyle}"
                                             Tag="Log"/>
                                <RadioButton x:Name="OutputTabButton" 
                                             Content="{x:Static res:Strings.Main_OutputInfo}" 
                                             Checked="TabButton_Checked"
                                             Style="{DynamicResource TabToggleStyle}"
                                             Tag="Output"/>
                            </StackPanel>
                            <!-- 下方标签滑动指示条 -->
                            <Border x:Name="BottomTabIndicator"
                                    Height="2" Background="{DynamicResource TitleUnderlineBrush}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Width="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BottomTabIndicatorTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        
                        <!-- 执行日志页面 -->
                        <Border x:Name="LogPanel" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                            <!-- TODO: Replace with RichTextBox if formatted text is needed -->
                            <Grid>
                                <!-- 无日志时居中显示提示 -->
                                <TextBlock Text="{x:Static res:Strings.Main_NoLogsHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           FontFamily="Lora, Georgia, SimSun, Segoe UI"
                                           Visibility="{Binding LogText, Converter={StaticResource NullToVisibleConverter}}"/>
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="LogTextBox"
                                             Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="11"
                                             BorderThickness="0"
                                             TextWrapping="NoWrap"
                                             Padding="8">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.Main_ClearLog}" Click="ClearLog_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ExportLog}" Click="ExportLog_Click"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- 输出信息页面 -->
                        <Border x:Name="OutputPanel" Grid.Row="1" Background="Transparent" ClipToBounds="True" Visibility="Collapsed">
                            <Grid>
                                <!-- 空状态居中提示 -->
                                <TextBlock x:Name="OutputEmptyHint"
                                           Text="{x:Static res:Strings.Main_NoTaskSelected}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           FontFamily="Lora, Georgia, SimSun, Segoe UI"/>
                                <!-- 有数据时的输出信息 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OutputInfoPanel" Margin="10"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- ==== 加载动画遮罩层 ==== -->
        <Grid x:Name="LoadingOverlay" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" Background="{DynamicResource AppBackgroundBrush}" Grid.RowSpan="10" Grid.ColumnSpan="10" Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 圆弧旋转 Spinner（纯 Path，不依赖字体） -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,18"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="LoadingSpinnerTransform" Angle="0"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="LoadingSpinnerTransform"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <!-- 轨道圆环（暗色底） -->
                    <Ellipse Width="56" Height="56"
                             Stroke="{DynamicResource BorderLightBrush}"
                             StrokeThickness="5"
                             Fill="Transparent"/>
                    <!-- 进度弧（亮色，覆盖约 270° 的弧段） -->
                    <Path Stroke="{DynamicResource PrimaryButtonBgBrush}"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 28,3 A 25,25 0 1 1 3,28"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="正在加载流程 / Loading Workflow..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==== 主题切换遮罩层 ==== -->
        <Grid x:Name="ThemeTransitionOverlay" Visibility="Collapsed" Background="{DynamicResource AppBackgroundBrush}" Grid.RowSpan="10" Grid.ColumnSpan="10" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ThemeTransitionIcon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="切换主题 / Theme" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
    
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Style.Resources>
                <!-- 右键菜单字体（ContextMenu 不继承 Window 的 FontFamily） -->
                <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
                    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
                </Style>
                <!-- 工具栏按钮样式 -->
                <Style x:Key="ToolbarButton" TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonGreen" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessColorBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonRed" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerButtonBgBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonDark" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="VerticalSeparator" TargetType="Separator">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Margin" Value="8,4"/>
                    <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                </Style>
                
                <!-- 平滑自适应工具栏样式 -->
                <Style x:Key="FlatToolBar" TargetType="ToolBar">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToolBar">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 主要显示区 -->
                                    <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" Grid.Column="0" Margin="0" Background="Transparent" VerticalAlignment="Center" />
                                    
                                    <!-- 溢出展开按钮 -->
                                    <ToggleButton x:Name="OverflowButton" Grid.Column="1" ClickMode="Press" 
                                                  IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0" Padding="6,2">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <TextBlock Text="···" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="16" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- 溢出下拉菜单 -->
                                    <Popup x:Name="OverflowPopup" AllowsTransparency="True" Placement="Bottom" 
                                           IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                           StaysOpen="False" Focusable="False">
                                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                                            </Border.Effect>
                                            <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="NaN" Focusable="True" FocusVisualStyle="{x:Null}">
                                                <!-- 这里由于默认也是换行机制，可以直接定义它的布局机制为 StackPanel -->
                                                <ToolBarOverflowPanel.LayoutTransform>
                                                    <RotateTransform Angle="0" />
                                                </ToolBarOverflowPanel.LayoutTransform>
                                            </ToolBarOverflowPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasOverflowItems" Value="False">
                                        <Setter TargetName="OverflowButton" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                
                <!-- Anthropic 风格标签切换按钮样式 -->
                <Style x:Key="TabToggleStyle" TargetType="RadioButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="TabBorder" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="0" 
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="Transparent"/>
                                        <Setter TargetName="TabBorder" Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Style>
</Window>

