<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskFlow"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        xmlns:conv="clr-namespace:TaskFlow.Converters"
        xmlns:models="clr-namespace:TaskFlow.Models.TaskCards"
        xmlns:res="clr-namespace:TaskFlow.Resources"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="640" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#f0eee6"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

    <!-- WindowChrome：保留原生拖拽/缩放/Snap Layout，允许自定义标题栏内容 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <conv:TaskStatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:SelectedToBorderColorConverter x:Key="SelectedToBorderConverter"/>
        <conv:CollapseIconConverter x:Key="CollapseIconConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <conv:CollapseIconVisibilityConverter x:Key="CollapseIconVisConverter"/>
        <conv:DragHandleVisibilityConverter x:Key="DragHandleVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:MatToBitmapSourceConverter x:Key="MatToImageConverter"/>
        <conv:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
        <conv:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter"/>
        
        <!-- ListBoxItem 透明样式，去除默认选中高亮 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 任务卡片模板 — 精简版（减少元素数量以提升虚拟化性能） -->
        <conv:TaskStatusToIconConverter x:Key="StatusToIconConverter"/>
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TaskCardBase}">
            <Border x:Name="CardBorder"
                    Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}"
                    Padding="12"
                    CornerRadius="8"
                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                    BorderBrush="{Binding IsSelected, Converter={StaticResource SelectedToBorderConverter}}"
                    BorderThickness="1.5"
                    Cursor="Hand"
                    Visibility="{Binding IsHiddenByCollapse, Converter={StaticResource InverseBoolToVisConverter}}"
                    MouseLeftButtonDown="TaskCard_MouseLeftButtonDown"
                    MouseMove="TaskCard_MouseMove"
                    AllowDrop="True"
                    Drop="TaskCard_Drop"
                    DragOver="TaskCard_DragOver"
                    MouseRightButtonUp="TaskCard_MouseRightButtonUp">
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 折叠按钮 + 拖拽手柄 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IsCollapsed, Converter={StaticResource CollapseIconConverter}}"
                                   Visibility="{Binding BranchRole, Converter={StaticResource CollapseIconVisConverter}}"
                                   Foreground="#6b6a65"
                                   FontSize="12"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="≡" 
                                   FontSize="18" 
                                   Foreground="#b0aea5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Cursor="SizeAll">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource DragHandleVisConverter}">
                                    <Binding Path="BranchRole"/>
                                    <Binding Path="IsCollapsed"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 任务信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" 
                                   FontFamily="Georgia, Microsoft YaHei"
                                   FontWeight="SemiBold" 
                                   Foreground="#141413"
                                   FontSize="14"/>
                        <TextBlock Foreground="#6b6a65" FontSize="11" Margin="0,2,0,0">
                            <Run Text="#"/>
                            <Run Text="{Binding Order, Mode=OneWay}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding TaskTypeName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 状态指示（直接绑定，移除 DataTrigger） -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                               FontSize="16"
                               Foreground="#141413"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- Anthropic 浅色极简滚动条样式 -->
        <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#f0efe8"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#c8c6be"/>
        <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#b0aea5"/>
        <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#8a8880"/>

        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollBar.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScrollBar.Static.Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 减小滚动条宽度到 10px -->
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- 移除上下箭头按钮，让轨道占满 -->
                            <!-- IsEnabled 固定为 true，避免拖拽时鼠标移出滚动条区域导致 Track 被禁用而卡顿 -->
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- 赋予 Thumb 视觉反馈 -->
                                    <Thumb Style="{StaticResource DarkScrollThumbStyle}" Background="{StaticResource ScrollBar.Static.Thumb}" x:Name="Thumb"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource ScrollBar.MouseOver.Thumb}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true" SourceName="Thumb">
                                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource ScrollBar.Pressed.Thumb}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#f0eee6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- 自定义标题栏 -->
                <RowDefinition Height="50"/> <!-- 工具栏 -->
                <RowDefinition Height="*"/>  <!-- 主内容 -->
            </Grid.RowDefinitions>

            <!-- ====== 自定义标题栏 ====== -->
            <Grid Grid.Row="0" Background="#f0eee6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题文字（可拖拽区域，由 WindowChrome CaptionHeight 控制） -->
                <TextBlock Text="{Binding WindowTitle}"
                           FontFamily="Georgia, Microsoft YaHei"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#45443f"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- 最小化 -->
                    <Button Click="TitleBar_Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Main_Minimize}">
                        <TextBlock Text="─" FontSize="10" Foreground="#6b6a65" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#e8e6dc"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 最大化/还原 -->
                    <Button x:Name="TitleBarMaxRestoreBtn" Click="TitleBar_MaxRestore_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Main_Maximize}">
                        <TextBlock x:Name="TitleBarMaxRestoreIcon" Text="☐" FontSize="12" Foreground="#6b6a65" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#e8e6dc"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 关闭 -->
                    <Button Click="TitleBar_Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Common_Close}">
                        <TextBlock Text="✕" FontSize="11" Foreground="#6b6a65" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#c45b4a"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 顶部工具栏 -->
            <Border Grid.Row="1" Background="#faf9f5" Padding="6,4" BorderBrush="#e3dacc" BorderThickness="1" CornerRadius="8" Margin="8,2,8,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 左侧文件操作 -->
                        <ColumnDefinition Width="*"/>    <!-- 中间收纳操作 -->
                        <ColumnDefinition Width="Auto"/> <!-- 右侧运行操作 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧核心 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NewProjectCommand}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📋 "/><TextBlock Text="{x:Static res:Strings.Main_NewProject}"/></StackPanel></Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="💾 "/><TextBlock Text="{x:Static res:Strings.Main_SaveProject}"/></StackPanel></Button>
                        <Button Command="{Binding SaveAsCommand}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📄 "/><TextBlock Text="{x:Static res:Strings.Main_SaveAs}"/></StackPanel></Button>
                        <Button Command="{Binding LoadCommand}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📂 "/><TextBlock Text="{x:Static res:Strings.Main_Load}"/></StackPanel></Button>
                        <Separator Style="{StaticResource VerticalSeparator}"/>
                    </StackPanel>

                    <!-- 中间弹性收纳区 -->
                    <ToolBarTray Grid.Column="1" Background="Transparent" IsLocked="True" VerticalAlignment="Center">
                        <ToolBar x:Name="MainToolBar" Style="{DynamicResource FlatToolBar}"  MinHeight="0" Padding="0,0,0,0" ToolBarTray.IsLocked="True">
                            <!-- Button在ToolBar中默认样式会被覆盖，必须显式指定Style -->
                            <Button Click="HideToTray_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="🔽 "/><TextBlock Text="{x:Static res:Strings.Main_Hide}"/></StackPanel></Button>
                            <Button Click="OpenSettings_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙ "/><TextBlock Text="{x:Static res:Strings.Main_Settings}"/></StackPanel></Button>
                            <Button Click="OpenVariableManager_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📦 "/><TextBlock Text="{x:Static res:Strings.Main_Variables}"/></StackPanel></Button>
                            <Button Click="OpenFlowManager_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📑 "/><TextBlock Text="{x:Static res:Strings.Main_Flows}"/></StackPanel></Button>
                            <Button Click="OpenModelManager_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="📱 "/><TextBlock Text="{x:Static res:Strings.Main_Models}"/></StackPanel></Button>
                            <Button Click="OpenHelp_Click" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="❓ "/><TextBlock Text="{x:Static res:Strings.Common_Help}"/></StackPanel></Button>
                        </ToolBar>
                    </ToolBarTray>

                    <!-- 右侧核心 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Separator Style="{StaticResource VerticalSeparator}"/>
                        <Button Command="{Binding RunSelectedCommand}" Style="{StaticResource ToolbarButton}" Margin="4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="▷ "/><TextBlock Text="{x:Static res:Strings.Main_RunOnce}"/></StackPanel></Button>
                        <!-- 运行组合按钮（带下拉切换运行当前/运行全部）— 深色一体化 -->
                        <Grid x:Name="RunModeGrid" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RunModeButton" Content="{x:Static res:Strings.Main_RunCurrent}" 
                                    Command="{Binding RunCurrentFlowCommand}" 
                                    Padding="12,6,4,6" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}"
                                                BorderBrush="#e3dacc" BorderThickness="1,1,0,1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#2a2a28"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#f0efe8"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#141413"/>
                                        <Setter Property="Foreground" Value="#faf9f5"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton x:Name="RunModeDropdown" Grid.Column="1" 
                                          Click="RunModeDropdown_Click"
                                          WindowChrome.IsHitTestVisibleInChrome="True"
                                          Cursor="Hand" Padding="4,6" BorderThickness="0">
                                <TextBlock x:Name="RunModeDropdownIcon" Text="▾" FontSize="10" Foreground="#faf9f5"/>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}"
                                                BorderBrush="#e3dacc" BorderThickness="0,1,1,1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#2a2a28"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#f0efe8"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="#141413"/>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.ContextMenu>
                                    <ContextMenu x:Name="RunModeMenu">
                                        <MenuItem Header="{x:Static res:Strings.Main_RunCurrentFlow}" Click="RunModeCurrent_Click"/>
                                        <MenuItem Header="{x:Static res:Strings.Main_RunAllFlows}" Click="RunModeAll_Click"/>
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                        </Grid>
                        <Button x:Name="StopAllButton" Content="{x:Static res:Strings.Main_StopAll}" Command="{Binding StopExecutionCommand}" Margin="4,0"
                                Padding="12,6" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            BorderBrush="#e3dacc" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 非运行状态 hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsRunning}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#f0efe8"/>
                                        </MultiDataTrigger>
                                        <!-- 运行状态 hover：橙色微深 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsRunning}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#c4623f"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#faf9f5"/>
                                    <Setter Property="Foreground" Value="#141413"/>
                                    <Style.Triggers>
                                        <!-- 空，由 code-behind 动画驱动颜色变化 -->
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧任务卡片画布 -->
                <Border Grid.Column="0" Background="#f0eee6" Margin="8"  CornerRadius="8" BorderThickness="1" BorderBrush="#e3dacc">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 左侧分页标签栏 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ScrollViewer x:Name="TabScrollViewer" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center">
                        <Grid>
                            <ItemsControl x:Name="FlowTabItemsControl" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" 
                                            Click="TabItem_Click"
                                            Tag="{Binding}"
                                            Margin="2,0"
                                            Padding="10,4"
                                            MinWidth="100"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            FontSize="12">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#b0aea5"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="TabBd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6,6,0,0"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    BorderThickness="0,0,0,2"
                                                                    BorderBrush="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="TabBd" Property="Background" Value="#e8e6dc"/>
                                                                    <Setter Property="Foreground" Value="#6b6a65"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#141413"/>
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="White"
                                                                            CornerRadius="6,6,0,0"
                                                                            Padding="{TemplateBinding Padding}"
                                                                            BorderThickness="0,0,0,2"
                                                                            BorderBrush="Transparent">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            <!-- 流程标签滑动指示条 -->
                            <Border x:Name="FlowTabIndicator"
                                    Height="2" Background="#d97757"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Width="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="FlowTabIndicatorTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        </ScrollViewer>

                        
                        <!-- 向左滚动按钮 -->
                        <Button Content="◀" 
                                Click="TabScrollLeft_Click"
                                Width="20" Height="24" 
                                FontSize="10"
                                Foreground="#b0aea5" Background="Transparent" 
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="4,0,0,0"
                                ToolTip="向左滚动">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#e8e6dc"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- 向右滚动按钮 -->
                        <Button Content="▶" 
                                Click="TabScrollRight_Click"
                                Width="20" Height="24" 
                                FontSize="10"
                                Foreground="#b0aea5" Background="Transparent" 
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="2,0,0,0"
                                ToolTip="向右滚动">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#e8e6dc"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                    </StackPanel>

                        <ListBox Grid.Row="1" x:Name="TaskCanvas"
                                      ItemsSource="{Binding TaskCards}"
                                      ItemTemplate="{StaticResource TaskCardTemplate}"
                                      AllowDrop="True"
                                      Drop="Canvas_Drop"
                                      DragOver="Canvas_DragOver"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8"
                                      PreviewMouseLeftButtonDown="Canvas_PreviewMouseLeftButtonDown"
                                      Loaded="TaskCanvas_Loaded"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="0.5,0.5"
                                      VirtualizingPanel.CacheLengthUnit="Page"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      SelectionMode="Single">
                            <ListBox.ContextMenu>
                                <ContextMenu ContextMenuOpening="TaskList_ContextMenuOpening">
                                    <MenuItem Header="{x:Static res:Strings.Main_SearchTask}" Click="SearchTask_Click" Tag="Search"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static res:Strings.Main_AddTask}">
                                        <!-- 通用 -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_General}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_PauseTask}" Click="AddTask_Click" Tag="PauseTask"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_GetTimestamp}" Click="AddTask_Click" Tag="GetTimestamp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EndTask}" Click="AddTask_Click" Tag="EndTask"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EndAllFlows}" Click="AddTask_Click" Tag="EndAllFlows"/>
                                        </MenuItem>
                                        <!-- Windows -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_WinOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinLaunchApp}" Click="AddTask_Click" Tag="WinLaunchApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinScreenshot}" Click="AddTask_Click" Tag="WinScreenshot"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinClick}" Click="AddTask_Click" Tag="WinClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinCloseApp}" Click="AddTask_Click" Tag="WinCloseApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinUiAutomation}" Click="AddTask_Click" Tag="WinUiAutomation"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinSimulateInput}" Click="AddTask_Click" Tag="WinSimulateInput"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_WinSubtitle}" Click="AddTask_Click" Tag="WinSubtitle"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_EventListener}" Click="AddTask_Click" Tag="EventListener"/>
                                        </MenuItem>
                                        <!-- ADB -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_AdbOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbConnect}" Click="AddTask_Click" Tag="AdbConnect"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbLaunchApp}" Click="AddTask_Click" Tag="AdbLaunchApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbScreenshot}" Click="AddTask_Click" Tag="AdbScreenshot"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbClick}" Click="AddTask_Click" Tag="AdbClick"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbCloseApp}" Click="AddTask_Click" Tag="AdbCloseApp"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_AdbDisconnect}" Click="AddTask_Click" Tag="AdbDisconnect"/>
                                        </MenuItem>
                                        <!-- Image Processing -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_ImgProc}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgCrop}" Click="AddTask_Click" Tag="ImgCrop"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgTemplateMatch}" Click="AddTask_Click" Tag="ImgTemplateMatch"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgOcr}" Click="AddTask_Click" Tag="ImgOcr"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgColorDetect}" Click="AddTask_Click" Tag="ImgColorDetect"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgColorSegment}" Click="AddTask_Click" Tag="ImgColorSegment"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgPreprocess}" Click="AddTask_Click" Tag="ImgPreprocess"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgBlobAnalysis}" Click="AddTask_Click" Tag="ImgBlobAnalysis"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ImgResize}" Click="AddTask_Click" Tag="ImgResize"/>
                                        </MenuItem>
                                        <!-- Data Processing -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_DataProc}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ExpressionEval}" Click="AddTask_Click" Tag="ExpressionEval"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_StringSubstring}" Click="AddTask_Click" Tag="StringSubstring"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_TypeConvert}" Click="AddTask_Click" Tag="TypeConvert"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArrayParse}" Click="AddTask_Click" Tag="ArrayParse"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArrayBuilder}" Click="AddTask_Click" Tag="ArrayBuilder"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_FileRead}" Click="AddTask_Click" Tag="FileRead"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_ArraySearch}" Click="AddTask_Click" Tag="ArraySearch"/>
                                        </MenuItem>
                                        <!-- AI -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_AiOps}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmTranslate}" Click="AddTask_Click" Tag="LlmTranslate"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmVision}" Click="AddTask_Click" Tag="LlmVision"/>
                                            <MenuItem Header="{x:Static res:Strings.TaskType_LlmFileTranslate}" Click="AddTask_Click" Tag="LlmFileTranslate"/>
                                        </MenuItem>
                                        <!-- Control Flow -->
                                        <MenuItem Header="{x:Static res:Strings.Menu_ControlFlow}">
                                            <MenuItem Header="{x:Static res:Strings.TaskType_BreakLoop}" Click="AddTask_Click" Tag="BreakLoop"/>
                                            <MenuItem Header="{x:Static res:Strings.Menu_IfElseBranch}" Click="AddBranch_Click" Tag="IfElse"/>
                                            <MenuItem Header="{x:Static res:Strings.Menu_ForLoop}" Click="AddBranch_Click" Tag="ForLoop"/>
                                        </MenuItem>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    
                    <!-- 空状态提示 -->
                    <TextBlock Text="{x:Static res:Strings.Main_EmptyHint}"
                               Grid.Row="1"
                               Foreground="#b0aea5"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding TaskCards.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}"/>
                </Grid>
            </Border>
            
            <!-- 分隔器 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
            
            <!-- 右侧显示与通知区 -->
            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 可切换显示窗口 -->
                    <Border Grid.Row="0" Background="#faf9f5" CornerRadius="8" BorderBrush="#e8e6dc" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 标签切换按钮 -->
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="TopTabContainer">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PreviewTabButton" 
                                                 Content="{x:Static res:Strings.Main_ImagePreview}" 
                                                 IsChecked="True"
                                                 Checked="ImageTabButton_Checked"
                                                 Style="{DynamicResource TabToggleStyle}"
                                                 Tag="Preview"/>
                                    <RadioButton x:Name="LiveTabButton" 
                                                 Content="{x:Static res:Strings.Main_LiveView}" 
                                                 Checked="ImageTabButton_Checked"
                                                 Style="{DynamicResource TabToggleStyle}"
                                                 Tag="Live"/>
                                </StackPanel>
                                <!-- 上方标签滑动指示条 -->
                                <Border x:Name="TopTabIndicator"
                                        Height="2" Background="#d97757"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left"
                                        Width="0" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TopTabIndicatorTransform"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <!-- 坐标文本（仅图像预览时有意义） -->
                            <TextBlock x:Name="ImageCoordinateText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="#6a9bcc" 
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- 图像预览页面 -->
                            <Border x:Name="ImagePreviewPanel" Grid.Row="1" Margin="8" Background="#f0eee6" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <!-- 无图像时居中显示文字 -->
                                <TextBlock Text="No image (∀&lt;)"
                                           Foreground="#c8c6be" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding DisplayImage, Converter={StaticResource NullToVisibleConverter}}"/>
                                <ScrollViewer x:Name="ImageScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent"
                                              SizeChanged="ImageScrollViewer_SizeChanged">
                                    <Image x:Name="PreviewImage"
                                           Source="{Binding DisplayImage, Converter={StaticResource MatToImageConverter}}"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseMove="PreviewImage_MouseMove"
                                           MouseLeave="PreviewImage_MouseLeave"
                                           MouseWheel="PreviewImage_MouseWheel">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                        <Image.ContextMenu>
                                            <ContextMenu ContextMenuOpening="PreviewContextMenu_Opening">
                                                <MenuItem Header="{x:Static res:Strings.Main_SaveImage}" Click="SavePreviewImage_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ResetSize}" Click="ResetImageSize_Click"/>
                                            </ContextMenu>
                                        </Image.ContextMenu>
                                    </Image>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- 实时显示页面 -->
                            <Border x:Name="LivePreviewPanel" Grid.Row="1" Margin="8" Background="#f0eee6" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed">
                            <Grid>
                                <!-- 实时画面（支持缩放和滚动） -->
                                <ScrollViewer x:Name="LiveScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                    <Image x:Name="LivePreviewImage"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseMove="LivePreviewImage_MouseMove"
                                           MouseLeave="LivePreviewImage_MouseLeave"
                                           MouseWheel="LivePreviewImage_MouseWheel">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="LiveImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                        <Image.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.Main_SaveImage}" Click="SaveLiveImage_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ResetSize}" Click="ResetLiveImageSize_Click"/>
                                            </ContextMenu>
                                        </Image.ContextMenu>
                                    </Image>
                                </ScrollViewer>
                                
                                <!-- 无内容提示 -->
                                <TextBlock x:Name="LivePreviewHint"
                                           Text="{x:Static res:Strings.Main_LiveStartHint}"
                                           Foreground="#b0aea5"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                
                                <!-- 左下角浮动按钮组 -->
                                    <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                            Margin="8,0,0,8">
                                    <!-- 播放按钮 -->
                                    <Button x:Name="BtnLiveStart" Content="▶" Click="LivePreviewStart_Click"
                                            Width="28"  FontSize="22" Padding="0"
                                            Background="Transparent" Foreground="#b0aea5" BorderThickness="0" Cursor="Hand"
                                            ToolTip="开始实时显示">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="#e3dacc"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 停止按钮 -->
                                    <Button x:Name="BtnLiveStop" Content="■" Click="LivePreviewStop_Click"
                                            Width="28" FontSize="22" Padding="0"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            ToolTip="停止实时显示" Visibility="Collapsed">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="#c4623f"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 设置按钮 -->
                                    <Button x:Name="BtnLiveSettings" Content="◉" Click="LivePreviewSettings_Click"
                                        Width="28" Height="28" FontSize="22" Padding="0" VerticalAlignment="Center"
                                        Background="Transparent" Foreground="#b0aea5" BorderThickness="0"  Cursor="Hand" 
                                        ToolTip="{x:Static res:Strings.Main_LiveSettings}" Margin="4,2,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.7" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Bg" Property="Background" Value="#e3dacc"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 分隔器 -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                
                <!-- 可切换通知窗口 -->
                    <Border Grid.Row="2" Background="#faf9f5" CornerRadius="8" BorderBrush="#e8e6dc" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 标签切换按钮 -->
                        <Grid x:Name="BottomTabContainer" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LogTabButton" 
                                             Content="{x:Static res:Strings.Main_RunLog}" 
                                             IsChecked="True"
                                             Checked="TabButton_Checked"
                                             Style="{DynamicResource TabToggleStyle}"
                                             Tag="Log"/>
                                <RadioButton x:Name="OutputTabButton" 
                                             Content="{x:Static res:Strings.Main_OutputInfo}" 
                                             Checked="TabButton_Checked"
                                             Style="{DynamicResource TabToggleStyle}"
                                             Tag="Output"/>
                            </StackPanel>
                            <!-- 下方标签滑动指示条 -->
                            <Border x:Name="BottomTabIndicator"
                                    Height="2" Background="#d97757"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Width="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BottomTabIndicatorTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        
                        <!-- 日志页面 -->
                            <Border x:Name="LogPanel" Grid.Row="1" Margin="8" Background="#f0eee6" CornerRadius="6">
                            <Grid>
                                <!-- 无日志时居中显示提示 -->
                                <TextBlock Text="No logs ∠)_"
                                           Foreground="#c8c6be" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding LogText, Converter={StaticResource NullToVisibleConverter}}"/>
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="LogTextBox"
                                             Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#45443f"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="11"
                                             BorderThickness="0"
                                             TextWrapping="NoWrap"
                                             Padding="8">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.Main_ClearLog}" Click="ClearLog_Click"/>
                                                <MenuItem Header="{x:Static res:Strings.Main_ExportLog}" Click="ExportLog_Click"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- 输出信息页面 -->
                            <Border x:Name="OutputPanel" Grid.Row="1" Margin="8" Background="#f0eee6" CornerRadius="6" Visibility="Collapsed">
                            <Grid>
                                <!-- 空状态居中提示 -->
                                <TextBlock x:Name="OutputEmptyHint"
                                           Text="{x:Static res:Strings.Main_NoTaskSelected}" 
                                           Foreground="#b0aea5" 
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- 有数据时的输出信息 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OutputInfoPanel" Margin="10"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
    
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Style.Resources>
                <!-- 右键菜单字体（ContextMenu 不继承 Window 的 FontFamily） -->
                <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
                    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
                </Style>
                <!-- 工具栏按钮样式 -->
                <Style x:Key="ToolbarButton" TargetType="Button">
                    <Setter Property="Background" Value="#faf9f5"/>
                    <Setter Property="Foreground" Value="#141413"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="#e3dacc"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f0efe8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonGreen" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Foreground" Value="#788c5d"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f0efe8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonRed" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Foreground" Value="#c45b4a"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f0efe8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="ToolbarButtonDark" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                    <Setter Property="Background" Value="#141413"/>
                    <Setter Property="Foreground" Value="#faf9f5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2a2a28"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <Style x:Key="VerticalSeparator" TargetType="Separator">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Margin" Value="8,4"/>
                    <Setter Property="Background" Value="#e8e6dc"/>
                </Style>
                
                <!-- 平滑自适应工具栏样式 -->
                <Style x:Key="FlatToolBar" TargetType="ToolBar">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToolBar">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 主要显示区 -->
                                    <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" Grid.Column="0" Margin="0" Background="Transparent" VerticalAlignment="Center" />
                                    
                                    <!-- 溢出展开按钮 -->
                                    <ToggleButton x:Name="OverflowButton" Grid.Column="1" ClickMode="Press" 
                                                  IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0" Padding="6,2">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <TextBlock Text="···" Foreground="#8a8880" FontSize="16" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#f0efe8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#e8e6dc"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- 溢出下拉菜单 -->
                                    <Popup x:Name="OverflowPopup" AllowsTransparency="True" Placement="Bottom" 
                                           IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                           StaysOpen="False" Focusable="False">
                                        <Border Background="White" BorderBrush="#e2d9cb" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#b0aea5" BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                                            </Border.Effect>
                                            <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="NaN" Focusable="True" FocusVisualStyle="{x:Null}">
                                                <!-- 这里由于默认也是换行机制，可以直接定义它的布局机制为 StackPanel -->
                                                <ToolBarOverflowPanel.LayoutTransform>
                                                    <RotateTransform Angle="0" />
                                                </ToolBarOverflowPanel.LayoutTransform>
                                            </ToolBarOverflowPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasOverflowItems" Value="False">
                                        <Setter TargetName="OverflowButton" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                
                <!-- Anthropic 风格标签切换按钮样式 -->
                <Style x:Key="TabToggleStyle" TargetType="RadioButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#b0aea5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="TabBorder" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="6,6,0,0" 
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="#141413"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="Transparent"/>
                                        <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#6b6a65"/>
                                        <Setter TargetName="TabBorder" Property="Background" Value="#f0efe8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Style>
</Window>
